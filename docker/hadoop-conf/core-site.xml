<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Konfigurasi SISI KLIEN untuk container jupyter.

  Container hadoop dan yarn membuat berkas konfigurasinya sendiri dari
  variabel lingkungan berpola CORE-SITE.XML_* yang disetel di
  docker-compose. Container jupyter dibangun dari image Spark, yang tidak
  punya mekanisme itu, sehingga konfigurasinya ditulis tangan di sini lalu
  di-mount. Tanpa berkas ini, Spark tidak tahu di mana ResourceManager
  berada dan akan gagal dengan pesan "Connecting to ResourceManager at
  0.0.0.0/0.0.0.0:8032" berulang kali.
-->
<configuration>

  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode:8020</value>
  </property>

  <property>
    <name>hadoop.tmp.dir</name>
    <value>/tmp/hadoop</value>
  </property>

</configuration>
