<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  dfs.replication adalah setelan SISI KLIEN. Menyetelnya di namenode saja
  tidak cukup: tanpa berkas ini, klien memakai bawaan 3 salinan, sehingga
  setiap keluaran MapReduce menempati 50% ruang lebih banyak daripada
  data lain di klaster ini yang memakai 2 salinan.
-->
<configuration>

  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>

  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>

</configuration>
