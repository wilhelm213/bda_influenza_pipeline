ALTER USER 'root'@'localhost' IDENTIFIED BY 'ISI_PASSWORD_MYSQL_ANDA';

CREATE DATABASE IF NOT EXISTS bda_influenza
  CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS 'bda'@'%' IDENTIFIED BY 'ISI_PASSWORD_MYSQL_ANDA';
ALTER USER 'bda'@'%' IDENTIFIED BY 'ISI_PASSWORD_MYSQL_ANDA';

GRANT ALL PRIVILEGES ON bda_influenza.* TO 'bda'@'%';

FLUSH PRIVILEGES;
